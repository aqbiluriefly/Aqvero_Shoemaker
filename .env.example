# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. Variables without the NEXT_PUBLIC_ prefix stay on the server.

# Public site URL (used for SEO metadata and links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only: show clearly-labelled sample products so filters and
# layouts can be tested with more than one product. Keep "false" in production.
SHOW_SAMPLE_PRODUCTS=false

# --- Shipping (Stage 3) ---
# Random secret used to sign shipping quotes (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SHIPPING_QUOTE_SECRET=
# Comma-separated list of active providers. "simulated" = development placeholder rates.
# Stage 5 adds: dhl, fedex, ups
SHIPPING_PROVIDERS=simulated
# Allow placing orders with SIMULATED shipping rates. Development only — keep false in production.
ALLOW_SIMULATED_CHECKOUT=false
